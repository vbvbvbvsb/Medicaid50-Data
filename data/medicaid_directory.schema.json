{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Medicaid operational reporting directory — schema 0.3, scoped route verification",
  "type": "object",
  "required": [
    "metadata",
    "states",
    "managed_care_routes",
    "portal_directory",
    "verification_queue",
    "sources",
    "vendor_matrix"
  ],
  "$defs": {
    "fact": {
      "type": "object",
      "required": [
        "value",
        "status",
        "source_ids",
        "verified_on",
        "note"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "VERIFIED — PRIMARY",
            "VERIFIED — CONTRACTOR",
            "CORROBORATED",
            "UNRESOLVED",
            "MANUAL VERIFICATION REQUIRED"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verified_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "qualified_route": {
      "type": "object",
      "required": [
        "route_id",
        "state",
        "transaction",
        "audit_as_of",
        "projection",
        "scope",
        "claim_types",
        "current_form_review",
        "evidence",
        "qualification_limit",
        "decision",
        "canonical_source_ids",
        "target_location"
      ],
      "properties": {
        "route_id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "transaction": {
          "type": "string"
        },
        "audit_as_of": {
          "type": "string"
        },
        "projection": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "current_form_review": {
          "type": "string"
        },
        "qualification_limit": {
          "type": "string"
        },
        "target_location": {
          "type": "string"
        },
        "claim_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "enum": [
              "PI",
              "WC"
            ]
          }
        },
        "decision": {
          "enum": [
            "QUALIFIED_NARROW_PUBLISHED_ROUTE"
          ]
        },
        "canonical_source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "capture_id",
              "url",
              "passage"
            ],
            "properties": {
              "capture_id": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "passage": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "held_route": {
      "type": "object",
      "required": [
        "route_id",
        "state",
        "claim_type",
        "transaction",
        "decision",
        "packet_id",
        "packet_file",
        "questions"
      ],
      "properties": {
        "route_id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "claim_type": {
          "type": "string"
        },
        "transaction": {
          "type": "string"
        },
        "packet_id": {
          "type": "string"
        },
        "packet_file": {
          "type": "string"
        },
        "target_location": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "HOLD_HUMAN_VERIFICATION"
          ]
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "properties": {
    "metadata": {
      "type": "object"
    },
    "states": {
      "type": "array",
      "minItems": 51,
      "maxItems": 51,
      "items": {
        "type": "object",
        "required": [
          "state_code",
          "state",
          "identification",
          "administration",
          "personal_injury",
          "workers_compensation",
          "workflow",
          "clarification_contact",
          "unresolved_issues",
          "verification"
        ],
        "properties": {
          "state_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "state": {
            "type": "string"
          },
          "identification": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/fact"
            }
          },
          "administration": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/fact"
            }
          },
          "personal_injury": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/fact"
            }
          },
          "workers_compensation": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/fact"
            }
          },
          "workflow": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/fact"
            }
          },
          "clarification_contact": {
            "$ref": "#/$defs/fact"
          },
          "unresolved_issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "object"
          }
        }
      }
    },
    "managed_care_routes": {
      "type": "array"
    },
    "portal_directory": {
      "type": "array"
    },
    "verification_queue": {
      "type": "array"
    },
    "sources": {
      "type": "array"
    },
    "vendor_matrix": {
      "type": "array"
    },
    "route_verification": {
      "type": "object",
      "required": [
        "audit_as_of",
        "default_decision",
        "qualified_routes",
        "held_routes",
        "deployment_performed",
        "scope_rule"
      ],
      "properties": {
        "audit_as_of": {
          "type": "string"
        },
        "default_decision": {
          "enum": [
            "HOLD_UNLESS_EXPLICITLY_QUALIFIED_FOR_EXACT_SCOPE"
          ]
        },
        "scope_rule": {
          "type": "string"
        },
        "deployment_performed": {
          "enum": [
            false
          ]
        },
        "qualified_routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qualified_route"
          }
        },
        "held_routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/held_route"
          }
        },
        "manual_confirmed_routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "route_id",
              "state",
              "claim_type",
              "transaction",
              "decision",
              "reviewed_on",
              "projection",
              "scope",
              "basis",
              "source_ids"
            ],
            "properties": {
              "route_id": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "claim_type": {
                "enum": [
                  "PI",
                  "WC"
                ]
              },
              "transaction": {
                "type": "string"
              },
              "decision": {
                "enum": [
                  "CONFIRMED_BY_USER_REVIEW"
                ]
              },
              "reviewed_on": {
                "type": "string"
              },
              "projection": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
